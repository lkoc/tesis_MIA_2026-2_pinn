notebooks_campaign/campaign_workspace/stage*/**/*.pt
notebooks_campaign/campaign_workspace/stage*/**/collocation.npz
notebooks_campaign/campaign_workspace/stage*/**/evaluation.npz

# Archivos temporales de compilación LaTeX
presentacion/*.aux
presentacion/*.log
presentacion/*.nav
presentacion/*.out
presentacion/*.snm
presentacion/*.toc
presentacion/*.vrb
